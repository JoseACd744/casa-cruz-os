# Puerto del servicio
PORT=4000

# Orígenes permitidos (la web), separados por coma
CORS_ORIGIN=http://localhost:3000

# Postgres. Mientras esté vacío, la API responde con los datos de demostración
# del núcleo y avisa en /salud que está en modo mock.
DATABASE_URL=

# Google Maps Static: el mapa de los PDFs. Sin clave se usan mosaicos abiertos
# (OpenStreetMap), que sirven para trabajar pero no son satelitales.
GOOGLE_MAPS_API_KEY=

# Kommo (etapa 7)
KOMMO_SUBDOMINIO=
KOMMO_TOKEN=
