# Puerto del servicio
PORT=4000

# Orígenes permitidos (la web), separados por coma
CORS_ORIGIN=http://localhost:3000

# Secreto para firmar los tokens de sesión. OBLIGATORIO en producción.
JWT_SECRET=

# Clave única de demostración mientras no haya base de datos.
CLAVE_DEMO=casacruz

# Postgres. Mientras esté vacío, la API responde con los datos de demostración
# del núcleo y avisa en /salud que está en modo mock.
DATABASE_URL=

# URL pública de la web (para los enlaces de las propuestas)
URL_PUBLICA=http://localhost:3000

# Bucket de archivos (Railway). Sin esto, la carga de imágenes responde 503.
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_URL_PUBLICA=

# Google Maps Static: el mapa de los PDFs. Sin clave se usan mosaicos abiertos
# (OpenStreetMap), que sirven para trabajar pero no son satelitales.
GOOGLE_MAPS_API_KEY=

# Kommo. Con subdominio y token, las propuestas escriben nota en el lead.
KOMMO_SUBDOMINIO=
KOMMO_TOKEN=
# Webhook de entrada: en Kommo se configura https://<api>/webhooks/kommo?clave=<este valor>
KOMMO_WEBHOOK_SECRETO=
