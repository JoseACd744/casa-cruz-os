    "@scalar/fastify-api-reference": "^1.69.2",
    "fastify": "^5.2.0",
    "fastify-type-provider-zod": "^7.0.0",
    "playwright": "^1.63.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^20",
    "prisma": "^6.1.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5"
  }
}
