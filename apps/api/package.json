{
  "name": "@casacruz/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "generate": "prisma generate",
    "migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "push": "prisma db push",
    "seed": "tsx --env-file-if-exists=.env prisma/seed.ts",
    "studio": "prisma studio",
    "test": "tsx --test src/*.test.ts",
    "acceso": "tsx --env-file-if-exists=.env prisma/acceso.ts",
    "marca": "tsx scripts/marca.ts",
    "test:postgres": "tsx --env-file-if-exists=.env --test --test-concurrency=1 src/*.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1137.0",
    "@aws-sdk/s3-request-presigner": "^3.1137.0",
    "@casacruz/core": "workspace:*",
    "@fastify/cors": "^10.0.1",
    "@fastify/jwt": "^10.2.2",
    "@fastify/multipart": "^10.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/swagger": "^9.8.1",
    "@prisma/client": "^6.1.0",
    "@scalar/fastify-api-reference": "^1.69.2",
    "fastify": "^5.2.0",
    "fastify-type-provider-zod": "^7.0.0",
    "playwright": "^1.63.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^20",
    "prisma": "^6.1.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
