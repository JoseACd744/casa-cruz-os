{
  "name": "casa-cruz-os",
  "private": true,
  "packageManager": "pnpm@9.9.0",
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@casacruz/web",
    "dev:api": "turbo run dev --filter=@casacruz/api",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter @casacruz/db generate",
    "db:push": "pnpm --filter @casacruz/db push",
    "db:seed": "pnpm --filter @casacruz/db seed",
    "db:studio": "pnpm --filter @casacruz/db studio"
  },
  "devDependencies": {
    "turbo": "^2.5.8",
    "typescript": "^5"
  }
}
