{
  "name": "casa-cruz-os",
  "private": true,
  "packageManager": "pnpm@9.9.0",
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@casacruz/web",
    "dev:api": "turbo run dev --filter=@casacruz/api",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @casacruz/api generate",
    "db:migrate": "pnpm --filter @casacruz/api migrate",
    "db:deploy": "pnpm --filter @casacruz/api migrate:deploy",
    "db:seed": "pnpm --filter @casacruz/api seed",
    "db:studio": "pnpm --filter @casacruz/api studio"
  },
  "devDependencies": {
    "turbo": "^2.5.8",
    "typescript": "^5"
  },
  "pnpm": {
    "overrides": {
      "@smithy/types": "4.19.0",
      "@smithy/core": "3.35.1"
    }
  }
}
